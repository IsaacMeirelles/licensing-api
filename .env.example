# Ambiente: development | production
ENVIRONMENT=development

# PostgreSQL local (o docker compose mapeia a porta 5432)
DATABASE_URL=postgresql+psycopg://licensing:licensing@localhost:5432/licensing

# Par de chaves Ed25519 para assinar as licencas.
# Gere com: uv run scripts/generate_keys.py
# A PRIVADA fica somente no servidor. A PUBLICA vai no seu software
# (cliente) para validacao offline.
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

# Segredo dos tokens de acesso dos administradores (troque em producao!)
JWT_SECRET=troque-este-segredo-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60
ISSUER=licensing-api

# Rate limit das rotas publicas
RATE_LIMIT_ENABLED=true

# Origens permitidas para CORS (lista em JSON)
CORS_ORIGINS=["*"]
